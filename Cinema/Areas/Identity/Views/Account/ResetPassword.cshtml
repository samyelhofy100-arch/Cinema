@model Cinema.ModelView.ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - Cinema</title>
    <link rel="stylesheet" href="~/css/account.css">
</head>
<body>

<div class="account-page">
    <div class="account-card">

        <div class="brand">
            <div class="brand-icon">🎬</div>
            <h2>Cinema</h2>
            <p>Almost there</p>
        </div>

        <h1 class="account-title">Reset Password</h1>
        <p class="account-subtitle">Choose a new password for your account.</p>

        <div asp-validation-summary="ModelOnly" class="form-message"></div>

        <form asp-area="Identity"
              asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <div class="form-group">
                <label asp-for="NewPassword">New Password</label>
                <div class="password-wrapper">
                    <input asp-for="NewPassword" type="password" class="form-control"
                           id="newPassword" placeholder="Enter new password" />
                    <span class="toggle-password" onclick="togglePassword('newPassword')">👁</span>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" type="password" class="form-control"
                           id="confirmPassword" placeholder="Confirm new password" />
                    <span class="toggle-password" onclick="togglePassword('confirmPassword')">👁</span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="account-btn">Reset Password</button>

        </form>

        <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="back-home">← Back to Login</a>

    </div>
</div>

<script src="~/js/account.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
