
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Cinema</title>
    <link rel="stylesheet" href="~/css/account.css">
</head>
<body>

<div class="account-page">
    <div class="account-card">

        <div class="brand">
            <div class="brand-icon">🎬</div>
            <h2>Cinema</h2>
            <p>Don't worry, we can help you!</p>
        </div>

        <h1 class="account-title">Forgot Password?</h1>

        <p class="account-subtitle">
            Enter your email address and we'll send you a link to reset your password.
        </p>

        <div id="formMessage" class="form-message"></div>

        <form onsubmit="return validateForm(event)">

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" class="form-control"
                       id="email" placeholder="Enter your registered email" required>
            </div>

            <button type="submit" class="account-btn">
                Send Reset Link
            </button>

        </form>

        <div class="account-footer">
            Remember your password?
            <a href="/Client/Account/Login" class="account-link">Login</a>
        </div>

        <a href="/Client" class="back-home">← Back to Home</a>

    </div>
</div>

<script src="~/js/account.js"></script>
</body>
</html>
