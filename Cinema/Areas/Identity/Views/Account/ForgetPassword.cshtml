@model Cinema.ModelView.ForgetPasswordVM

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Cinema</title>
    <link rel="stylesheet" href="~/css/account.css">
</head>
<body>

<div class="account-page">
    <div class="account-card">

        <div class="brand">
            <div class="brand-icon">🎬</div>
            <h2>Cinema</h2>
            <p>Don't worry, we can help you!</p>
        </div>

        <h1 class="account-title">Forgot Password?</h1>
        <p class="account-subtitle">
            Enter your email or username and we'll send you a verification code (OTP).
        </p>

        <div asp-validation-summary="ModelOnly" class="form-message"></div>

        <form asp-area="Identity"
              asp-controller="Account"
              asp-action="ForgetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="UserNameOrEmail">Email or Username</label>
                <input asp-for="UserNameOrEmail" class="form-control"
                       placeholder="Enter your email or username" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <button type="submit" class="account-btn">Send OTP</button>

        </form>

        <div class="account-footer">
            Remember your password?
            <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="account-link">Login</a>
        </div>

        <a asp-area="Client" asp-controller="Home" asp-action="Index" class="back-home">← Back to Home</a>

    </div>
</div>

<script src="~/js/account.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
