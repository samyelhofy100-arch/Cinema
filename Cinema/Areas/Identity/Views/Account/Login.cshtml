@model Cinema.ModelView.LoginVM

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Cinema</title>
    <link rel="stylesheet" href="~/css/account.css">
</head>
<body>

<div class="account-page">
    <div class="account-card">

        <div class="brand">
            <div class="brand-icon">🎬</div>
            <h2>Cinema</h2>
            <p>Your movie experience starts here</p>
        </div>

        <h1 class="account-title">Welcome Back!</h1>
        <p class="account-subtitle">Sign in to continue watching movies.</p>

        @if (TempData["Successful_Notification"] != null)
        {
            <div class="form-message" style="color:#22c55e;">@TempData["Successful_Notification"]</div>
        }
        @if (TempData["Error_Notification"] != null)
        {
            <div class="form-message">@TempData["Error_Notification"]</div>
        }

        <div asp-validation-summary="ModelOnly" class="form-message"></div>

        <form asp-area="Identity"
              asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="UserNameOrEmail">Email or Username</label>
                <input asp-for="UserNameOrEmail" class="form-control"
                       placeholder="Enter your email or username">
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <div class="password-wrapper">
                    <input asp-for="Password" type="password" class="form-control"
                           placeholder="Enter your password">
                    <span class="toggle-password" onclick="togglePassword('Password')">👁</span>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-options">
                <label class="remember">
                    <input asp-for="RememberMe">
                    Remember Me
                </label>

                <a asp-area="Identity" asp-controller="Account" asp-action="ForgetPassword" class="account-link">
                    Forgot Password?
                </a>
            </div>

            <button type="submit" class="account-btn">Login</button>

        </form>

        <div class="account-footer">
            Don't have an account?
            <a asp-area="Identity" asp-controller="Account" asp-action="Register" class="account-link">
                Create Account
            </a>

            <br>

            Didn't receive confirmation email?
            <a asp-area="Identity" asp-controller="Account" asp-action="ResendEmailConfirmation" class="account-link">
                Resend Email
            </a>
        </div>

        <a asp-area="Client" asp-controller="Home" asp-action="Index" class="back-home">
            ← Back to Home
        </a>

    </div>
</div>

<script src="~/js/account.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
