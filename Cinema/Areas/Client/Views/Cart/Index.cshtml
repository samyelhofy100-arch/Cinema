@model List<CartItem>

@{
    ViewData["Title"] = "Your cart";
    var total = Model.Sum(i => i.Showtime.Price);
    int secondsLeft = Model.Any() ? Math.Max(0, (int)(Model.Min(i => i.ExpiresAt) - DateTime.Now).TotalSeconds) : 0;
}

<link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />

<div class="container py-4">
    <h2 class="mb-3">🛒 Your cart</h2>

    @if (TempData["BookingError"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }

    @if (!Model.Any())
    {
        <p class="text-secondary">Your cart is empty. <a asp-controller="Home" asp-action="Index">Browse movies</a></p>
    }
    else
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <span>Your seats are held for</span>
            <strong class="fs-5" data-seconds="@secondsLeft">--:--</strong>
        </div>

        @foreach (var g in Model.GroupBy(i => i.ShowtimeId))
        {
            var st = g.First().Showtime;
            <div class="bk-cart-card">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <div class="fw-bold fs-5">@st.Movie.Name</div>
                        <div class="text-secondary">@st.Hall.Cinema.Name · @st.Hall.Name · @st.StartTime.ToString("ddd dd MMM, hh:mm tt")</div>
                    </div>
                    <a asp-controller="Booking" asp-action="Seats" asp-route-showtimeId="@st.Id" class="btn btn-sm btn-outline-light align-self-start">Change seats</a>
                </div>

                <div class="bk-chips">
                    @foreach (var item in g)
                    {
                        <form asp-action="Remove" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="bk-chip" title="Remove">@item.Seat.Label ✕</button>
                        </form>
                    }
                </div>

                <div class="text-end fw-semibold">@g.Count() × @st.Price.ToString("0.##") = @((g.Count() * st.Price).ToString("0.##")) EGP</div>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4">
            <form asp-action="Clear" method="post" data-confirm="Clear the cart?">
                <button class="btn btn-outline-danger">Clear cart</button>
            </form>
            <form asp-controller="Checkout" asp-action="Pay" method="post" class="d-flex align-items-center gap-3">
                <span class="fs-5">Total: <strong>@total.ToString("0.##") EGP</strong></span>
                <button class="btn btn-warning fw-semibold px-4">Pay with card</button>
            </form>
        </div>
    }
</div>

<script src="~/js/booking.js" asp-append-version="true"></script>