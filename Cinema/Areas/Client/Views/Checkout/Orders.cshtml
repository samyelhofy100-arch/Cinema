@model List<Order>

@{ ViewData["Title"] = "My tickets"; }
<link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />

<div class="container py-4">
    <h2 class="mb-4">🎫 My tickets</h2>

    @if (!Model.Any())
    {
        <p class="text-secondary">No bookings yet. <a asp-controller="Home" asp-action="Index">Browse movies</a></p>
    }

    @foreach (var o in Model)
    {
        <div class="mb-4">
            <div class="text-secondary small mb-2">Booking #@o.Id · @o.CreatedAt.ToString("dd MMM yyyy HH:mm") · @o.TotalAmount.ToString("0.##") EGP</div>
            <partial name="_Tickets" model="o" />
        </div>
    }
</div>