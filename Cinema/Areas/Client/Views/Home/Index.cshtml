@model List<Movie>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    ViewData["Title"] = "Movies";

    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    int? selectedCategoryId = ViewBag.CategoryId as int?;
    int? cinemaId = ViewBag.CinemaId as int?;
    int? actorId = ViewBag.ActorId as int?;
    string search = ViewBag.Search as string ?? "";
    string? searchRoute = string.IsNullOrWhiteSpace(search) ? null : search;

    int page = (int)ViewBag.Page;
    int pageSize = (int)ViewBag.PageSize;
    int totalPages = (int)ViewBag.TotalPages;
    int totalCount = (int)ViewBag.TotalCount;

    int from = totalCount == 0 ? 0 : (page - 1) * pageSize + 1;
    int to = Math.Min(page * pageSize, totalCount);
    int startPage = Math.Max(1, page - 2);
    int endPage = Math.Min(totalPages, page + 2);
    bool hasExtraFilter = cinemaId.HasValue || actorId.HasValue;

    // Optional custom banner: drop a file named hero.jpg into wwwroot/Images/
    bool hasHeroPhoto = System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "Images", "hero.jpg"));
    string? heroImg = hasHeroPhoto
        ? Url.Content("~/Images/hero.jpg")
        : (Model.Any() ? Url.Content("~/Images/MoiveImg/" + Model.First().MainImg) : null);
    var heroPosters = Model.Take(3).ToList();
}

<link rel="stylesheet" href="~/css/movies.css" asp-append-version="true" />

<!-- Hero -->
<section class="movies-hero">
    @if (heroImg != null)
    {
        <div class="movies-hero__bg @(hasHeroPhoto ? "movies-hero__bg--photo" : "")" style="background-image:url('@heroImg')"></div>
    }
    <div class="movies-hero__overlay"></div>

    <div class="container movies-hero__content">
      <div class="row align-items-center g-5">
        <div class="col-lg-7 movies-hero__text">
        <span class="movies-hero__badge">🎟 Now Showing</span>
        <h1 class="movies-hero__title">Find your next <span>movie night</span></h1>
        <p class="movies-hero__sub">@totalCount movies waiting for you. Search by name or pick a category.</p>

        <form method="get" asp-action="Index" id="filterForm" class="movies-filter">
            @if (cinemaId.HasValue)
            {
                <input type="hidden" name="cinemaId" value="@cinemaId" />
            }
            @if (actorId.HasValue)
            {
                <input type="hidden" name="actorId" value="@actorId" />
            }

            <div class="movies-filter__search">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by movie name..." autocomplete="off" />
            </div>
            <div class="movies-filter__select">
                <select name="categoryId" id="categorySelect" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id" selected="@(selectedCategoryId == category.Id)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="movies-filter__actions">
                <button type="submit" class="btn btn-warning fw-semibold">Search</button>
                <a asp-action="Index" class="btn btn-outline-light">Reset</a>
            </div>
        </form>
        </div>

        @if (heroPosters.Any())
        {
            <div class="col-lg-5 d-none d-lg-block">
                <div class="hero-posters">
                    @for (int i = 0; i < heroPosters.Count; i++)
                    {
                        var hp = heroPosters[i];
                        <a asp-action="Details" asp-route-id="@hp.Id" class="hero-poster hero-poster--@(i + 1)" title="@hp.Name">
                            <img src="~/Images/MoiveImg/@hp.MainImg" alt="@hp.Name" data-fallback />
                        </a>
                    }
                </div>
            </div>
        }
      </div>
    </div>
</section>

<div class="container movies-wrap">

    <div class="movies-toolbar">
        
        @if (hasExtraFilter)
        {
            <a asp-action="Index" class="movies-chip">Filtered &times; Clear</a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <article class="movie-card">
                        <a asp-action="Details" asp-route-id="@movie.Id" class="movie-card__poster">
                            <img src="~/Images/MoiveImg/@movie.MainImg" alt="@movie.Name" loading="lazy" data-fallback />
                            <span class="movie-card__price">@movie.Price.ToString("0.##") EGP</span>
                            @if (movie.Status)
                            {
                                <span class="movie-card__status movie-card__status--on">Available</span>
                            }
                            else
                            {
                                <span class="movie-card__status movie-card__status--off">Not available</span>
                            }
                            <span class="movie-card__overlay">View details</span>
                        </a>
                        <div class="movie-card__body">
                            <h3 class="movie-card__title" title="@movie.Name">@movie.Name</h3>
                            <div class="movie-card__meta">
                                <span class="movie-card__tag">@movie.Category?.Name</span>
                                <span class="movie-card__cinema">@movie.Cinema?.Name</span>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="movies-pager" aria-label="Movies pages">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(page - 1)"
                           asp-route-search="@searchRoute" asp-route-categoryId="@selectedCategoryId"
                           asp-route-cinemaId="@cinemaId" asp-route-actorId="@actorId">&laquo; Prev</a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="1"
                               asp-route-search="@searchRoute" asp-route-categoryId="@selectedCategoryId"
                               asp-route-cinemaId="@cinemaId" asp-route-actorId="@actorId">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p"
                               asp-route-search="@searchRoute" asp-route-categoryId="@selectedCategoryId"
                               asp-route-cinemaId="@cinemaId" asp-route-actorId="@actorId">@p</a>
                        </li>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@totalPages"
                               asp-route-search="@searchRoute" asp-route-categoryId="@selectedCategoryId"
                               asp-route-cinemaId="@cinemaId" asp-route-actorId="@actorId">@totalPages</a>
                        </li>
                    }

                    <li class="page-item @(page == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(page + 1)"
                           asp-route-search="@searchRoute" asp-route-categoryId="@selectedCategoryId"
                           asp-route-cinemaId="@cinemaId" asp-route-actorId="@actorId">Next &raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="movies-empty">
            <div class="movies-empty__icon">🎬</div>
            <h4>No movies found</h4>
            <p>Try a different name or category.</p>
            <a asp-action="Index" class="btn btn-warning">Show all movies</a>
        </div>
    }
</div>

<button type="button" id="backToTop" class="back-to-top" aria-label="Back to top">&uarr;</button>

@section Scripts {
    <script src="~/js/movies.js" asp-append-version="true"></script>
}
