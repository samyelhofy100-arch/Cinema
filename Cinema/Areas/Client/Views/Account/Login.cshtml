@model Cinema.ViewModels.LoginVM
@{
    ViewData["Title"] = "Login";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="auth-title">Welcome back 👋</h1>
        <p class="auth-sub">Login to book your next movie</p>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="UserNameOrEmail" class="form-label"></label>
                <input asp-for="UserNameOrEmail" class="form-control" autocomplete="username" />
                <span asp-validation-for="UserNameOrEmail" class="auth-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="auth-error"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-warning w-100 fw-semibold">Login</button>
        </form>

        <p class="auth-foot">New here? <a asp-action="Register">Create an account</a></p>
    </div>
</div>