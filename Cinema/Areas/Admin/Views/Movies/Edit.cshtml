@model Cinema.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
    var categories = ViewBag.Categories as List<Cinema.Models.Category>;
    var cinemas = ViewBag.Cinemas as List<Cinema.Models.Cinemas>;
    var actors = ViewBag.Actors as List<Cinema.Models.Actor>;
    var selectedActorIds = Model.MovieActors?.Select(ma => ma.ActorId).ToList() ?? new List<int>();
}

<div class="container py-4">
    <div class="card border-0 shadow-sm bg-dark text-white p-4">
        <h2 class="fw-bold mb-4">Edit Movie</h2>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MainImg" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label">Movie Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label">Price ($)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(categories, "Id", "Name", Model.CategoryId))">
                        <option value="">-- Select Category --</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="CinemaId" class="form-label">Cinema</label>
                    <select asp-for="CinemaId" class="form-select" asp-items="@(new SelectList(cinemas, "Id", "Name", Model.CinemaId))">
                        <option value="">-- Select Cinema --</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="DateTime" class="form-label">Release Date & Time</label>
                    <input asp-for="DateTime" type="datetime-local" class="form-control" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Current Main Image</label>
                    <div>
                        @if (!string.IsNullOrEmpty(Model.MainImg))
                        {
                            <img src="/movies/@Model.MainImg" class="rounded mb-2" style="width: 80px; height: 100px; object-fit: cover;" />
                        }
                        else
                        {
                            <p class="text-muted small">No main image</p>
                        }
                    </div>
                    <label class="form-label mt-2">Change Main Image (Optional)</label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                    <span class="text-danger">@Html.ValidationMessage("ImageFile")</span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Sub Images (Uploading new ones will replace existing ones)</label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @if (Model.SubImage != null && Model.SubImage.Any())
                        {
                            foreach (var sub in Model.SubImage)
                            {
                                <img src="/movies/@sub.Img" class="rounded" style="width: 50px; height: 60px; object-fit: cover;" />
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No sub images</span>
                        }
                    </div>
                    <input type="file" name="SubImages" class="form-control" accept="image/*" multiple />
                    <span class="text-danger">@Html.ValidationMessage("SubImages")</span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Actors</label>
                <select name="ActorIds" class="form-select" multiple size="4">
                    @if (actors != null)
                    {
                        foreach (var actor in actors)
                        {
                            bool isSelected = selectedActorIds.Contains(actor.Id);
                            <!option value="@actor.Id" @(isSelected ? "selected" : "")>@actor.Name</!option>
                        }
                    }
                </select>
                <small class="text-muted">Hold Ctrl to select multiple actors.</small>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="Status" class="form-check-input" type="checkbox" />
                <label asp-for="Status" class="form-check-label">Is Active / Available</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-semibold">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>