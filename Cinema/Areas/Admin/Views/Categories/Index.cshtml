@model IEnumerable<Cinema.Models.Category>

@{
    ViewData["Title"] = "Categories Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white">Categories Management</h2>
            <p class="text-muted">Manage movie categories.</p>
        </div>
        <a asp-action="Create" class="btn btn-warning fw-semibold">
            <i class="bi bi-plus-lg"></i> Add New Category
        </a>
    </div>

   

    <div class="card border-0 shadow-sm bg-dark text-white">
        <div class="card-body p-4">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Movies Count</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td><span class="badge bg-secondary">@(item.Movies?.Count ?? 0) Movies</span></td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white me-1">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1">Edit</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-3">No categories found.</p>
                    <a asp-action="Create" class="btn btn-outline-warning">Create First Category</a>
                </div>
            }
        </div>
    </div>
</div>