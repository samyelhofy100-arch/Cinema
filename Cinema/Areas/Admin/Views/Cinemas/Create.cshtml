@model Cinema.Models.Cinemas

@{
    ViewData["Title"] = "Add Cinema";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm bg-dark text-white p-4">
        <h2 class="fw-bold mb-4">Add New Cinema</h2>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Cinema Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter cinema name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Cinema Image</label>
                <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                <span class="text-danger">@Html.ValidationMessage("Img")</span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-semibold">Create</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>