@model Actor

@{
    ViewData["Title"] = "Actor Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">@Model.Name</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3 text-center">
            @if (!string.IsNullOrWhiteSpace(Model.Img))
            {
                <img src="~/Images/ActorImg/@Model.Img"
                     alt="@Model.Name"
                     class="img-fluid rounded-circle shadow-sm"
                     style="width: 200px; height: 200px; object-fit: cover;" />
            }
            else
            {
                <p class="text-muted">No image</p>
            }
        </div>

        <div class="col-md-9">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th style="width: 30%">Name</th>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <th>Movies Count</th>
                        <td>@(Model.MovieActors?.Count ?? 0)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <h4>Movies</h4>
        @if (Model.MovieActors != null && Model.MovieActors.Any())
        {
            <div class="row g-3">
                @foreach (var ma in Model.MovieActors)
                {
                    <div class="col-6 col-md-3">
                        <div class="card h-100">
                            <img src="~/Images/MoiveImg/@ma.Movie?.MainImg"
                                 class="card-img-top"
                                 alt="@ma.Movie?.Name"
                                 style="height: 250px; object-fit: cover;" />
                            <div class="card-body">
                                <h6 class="card-title mb-0">@ma.Movie?.Name</h6>
                            </div>
                            <div class="card-footer">
                                <a asp-controller="Movies" asp-action="Details"
                                   asp-route-id="@ma.MovieId"
                                   class="btn btn-sm btn-primary w-100">View Movie</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">This actor has no movies yet.</p>
        }
    </div>
</div>