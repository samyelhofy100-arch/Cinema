@model Cinema.Models.Actor

@{
    ViewData["Title"] = "Edit Actor";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm bg-dark text-white p-4">
        <h2 class="fw-bold mb-4">Edit Actor</h2>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Img" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Actor Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Img))
            {
                <div class="mb-3">
                    <label class="form-label">Current Image</label>
                    <div>
                        <img src="/Images/ActorImg/@Model.Img" class="rounded-circle mb-2" style="width: 80px; height: 80px; object-fit: cover;" />
                    </div>
                </div>
            }

            <div class="mb-4">
                <label class="form-label">Change Image (Optional)</label>
                <input type="file" name="imgFile" class="form-control" accept="image/*" />
                <span class="text-danger">@Html.ValidationMessage("imgFile")</span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-semibold">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>