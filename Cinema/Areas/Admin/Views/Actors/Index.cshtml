@model IEnumerable<Cinema.Models.Actor>
@{
    ViewData["Title"] = "Actors Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white">Actors Management</h2>
            <p class="text-muted">Manage all actors in the system.</p>
        </div>

        <a asp-action="Create" class="btn btn-warning fw-semibold">
            <i class="bi bi-plus-lg"></i> Add New Actor
        </a>
    </div>

    <form method="get" asp-action="Index" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control bg-dark text-white border-secondary"
                   placeholder="Search by actor name..." />

            <button type="submit" class="btn btn-outline-warning">
                Search
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Reset
                </a>
            }
        </div>
    </form>

    <div class="card border-0 shadow-sm bg-dark text-white">
        <div class="card-body p-4">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Actor Name</th>
                                <th>Movies Count</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var actor in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(actor.Img))
                                        {
                                            <img src="~/Images/ActorImg/@actor.Img" alt="@actor.Name"
                                                 class="rounded-circle"
                                                 style="width:50px;height:50px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                No Image
                                            </span>
                                        }
                                    </td>

                                    <td class="fw-semibold">
                                        @actor.Name
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @(actor.MovieActors?.Count ?? 0) Movies
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Details"
                                           asp-route-id="@actor.Id"
                                           class="btn btn-sm btn-info me-1">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@actor.Id"
                                           class="btn btn-sm btn-primary me-1">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@actor.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this actor?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-3">No actors found.</p>

                    <a asp-action="Create"
                       class="btn btn-outline-warning">
                        Create First Actor
                    </a>
                </div>
            }
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Actors pages">
                <ul class="pagination justify-content-center">

                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-area="Admin"
                           asp-controller="Actors"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-search="@ViewBag.Search">
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="Actors"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@ViewBag.Search">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-area="Admin"
                           asp-controller="Actors"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-search="@ViewBag.Search">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </div>
</div>