<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
        string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    <div class="adm-shell">
        <aside class="adm-sidebar" id="admSidebar">
            <a class="adm-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">
                🎬 <span>Cinema</span> <small>Admin</small>
            </a>

            <nav class="adm-nav">
                <a class="@Active("Home")" asp-area="Admin" asp-controller="Home" asp-action="Index">📊 Dashboard</a>
                <a class="@Active("Movies")" asp-area="Admin" asp-controller="Movies" asp-action="Index">🎞 Movies</a>
                <a class="@Active("Actors")" asp-area="Admin" asp-controller="Actors" asp-action="Index">🎭 Actors</a>
                <a class="@Active("Cinemas")" asp-area="Admin" asp-controller="Cinemas" asp-action="Index">🏛 Cinemas</a>
                <a class="@Active("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">🏷 Categories</a>
            </nav>

            <div class="adm-sidebar__foot">
                <a asp-area="Client" asp-controller="Home" asp-action="Index" target="_blank">↗ View website</a>
            </div>
        </aside>

        <div class="adm-main">
            <header class="adm-topbar">
                <button type="button" class="adm-burger" id="admBurger" aria-label="Menu">☰</button>
                <h1 class="adm-topbar__title">@ViewData["Title"]</h1>
            </header>

            <main class="adm-content">
                @if (TempData["Success"] is string ok)
                {
                    <div class="alert alert-success adm-alert" role="alert">✔ @ok</div>
                }
                @if (TempData["Error"] is string err)
                {
                    <div class="alert alert-danger adm-alert" role="alert">⚠ @err</div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
