
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Cinema</title>

    <script>
            document.documentElement.classList.add("js");
    </script>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Main Cinema CSS -->
    <link rel="stylesheet" href="~/css/cinema.css" asp-append-version="true" />

    <!-- Extra Cinema CSS -->
    <link rel="stylesheet" href="~/css/cinema-extra.css" asp-append-version="true" />

</head>

<body>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

        string Active(params string[] actions) =>
            actions.Contains(currentAction) ? "active" : "";
    }

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-md site-nav sticky-top" data-bs-theme="dark">

            <div class="container">

                <a class="navbar-brand"
                   asp-area="Client"
                   asp-controller="Home"
                   asp-action="Index">

                    🎬 <span>Cinema</span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#siteNav"
                        aria-controls="siteNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="siteNav">

                    <ul class="navbar-nav ms-auto gap-md-1">

                        <!-- Movies -->
                        <li class="nav-item">

                            <a class="nav-link @Active("Index", "Details")"
                               asp-area="Client"
                               asp-controller="Home"
                               asp-action="Index">

                                Movies

                            </a>

                        </li>

                        <!-- Cinemas -->
                        <li class="nav-item">

                            <a class="nav-link @Active("Cinemas")"
                               asp-area="Client"
                               asp-controller="Home"
                               asp-action="Cinemas">

                                Cinemas

                            </a>

                        </li>

                        <!-- Actors -->
                        <li class="nav-item">

                            <a class="nav-link @Active("Actors")"
                               asp-area="Client"
                               asp-controller="Home"
                               asp-action="Actors">

                                Actors

                            </a>

                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            <!-- Admin Dashboard -->
                            @if (User.IsInRole(SD.SuperAdmin) || User.IsInRole(SD.Admin))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Home"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>
                            }

                            <!-- Cart Count -->
                            <li class="nav-item">

                                @await Component.InvokeAsync("CartCount")

                            </li>

                            <!-- User Dropdown -->
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    👤 @User.Identity.Name

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <!-- Profile -->
                                    <li>

                                        <a class="dropdown-item"
                                           asp-area="Client"
                                           asp-controller="Profile"
                                           asp-action="Index">

                                            My profile

                                        </a>

                                    </li>

                                    <!-- Orders -->
                                    <li>

                                        <a class="dropdown-item"
                                           asp-area="Client"
                                           asp-controller="Checkout"
                                           asp-action="Orders">

                                            My orders

                                        </a>

                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <!-- Logout -->
                                    <li>

                                        <form asp-area="Client"
                                              asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            <button type="submit" class="dropdown-item">

                                                Logout

                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </li>

                        }
                        else
                        {

                            <!-- Login -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area="Client"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>

                            <!-- Register -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area="Client"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <!-- Main Content -->
    <main class="site-main" role="main">

        @if (TempData["Success"] is string okMsg)
        {
            <div class="container pt-3">

                <div class="alert alert-success mb-0">
                    ✔ @okMsg
                </div>

            </div>
        }

        @if (TempData["Error"] is string errMsg)
        {
            <div class="container pt-3">

                <div class="alert alert-danger mb-0">
                    ⚠ @errMsg
                </div>

            </div>
        }

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="site-footer">

        <div class="container">

            <div class="row g-4 py-5">

                <div class="col-md-5">

                    <div class="site-footer__brand">
                        🎬 <span>Cinema</span>
                    </div>

                    <p class="site-footer__text">

                        Browse the latest movies, discover the cinemas showing them,
                        and meet the stars behind the screen.

                    </p>

                </div>

                <div class="col-6 col-md-3 offset-md-1">

                    <h6 class="site-footer__title">
                        Explore
                    </h6>

                    <ul class="list-unstyled site-footer__links">

                        <li>
                            <a asp-area="Client"
                               asp-controller="Home"
                               asp-action="Index">
                                Movies
                            </a>
                        </li>

                        <li>
                            <a asp-area="Client"
                               asp-controller="Home"
                               asp-action="Cinemas">
                                Cinemas
                            </a>
                        </li>

                        <li>
                            <a asp-area="Client"
                               asp-controller="Home"
                               asp-action="Actors">
                                Actors
                            </a>
                        </li>

                    </ul>

                </div>

                <div class="col-6 col-md-3">

                    <h6 class="site-footer__title">
                        Quick info
                    </h6>

                    <ul class="list-unstyled site-footer__links">

                        <li>Daily shows</li>
                        <li>Online booking</li>
                        <li>Great sound &amp; picture</li>

                    </ul>

                </div>

            </div>

            <div class="site-footer__bottom">

                &copy; @DateTime.Now.Year Cinema. All rights reserved.

            </div>

        </div>

    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Main Cinema JavaScript -->
    <script src="~/js/cinema.js" asp-append-version="true"></script>

    <!-- Extra Cinema JavaScript -->
    <script src="~/js/cinema-extra.js" asp-append-version="true"></script>

    <!-- Page Scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
